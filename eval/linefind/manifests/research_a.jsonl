{"id": "A_v7721_0", "set": "A", "vn": "v7721", "shot": "v7721_95057.jpg", "url": "https://t.vndb.org/sf/57/95057.jpg", "sha256": "85c41cf8562fc085e8cb838b7498324d708600951439f239d416831e59ab107a", "platform": "psv", "region": [250, 410, 705, 472], "mask": [], "lines": [{"box": [260, 415, 702, 440], "text": "何の断りもなく乙女の尻尾を握りしめるなん", "ignore": false}, {"box": [259, 445, 700, 470], "text": "て、どういうつもりかと聞いてるのかな！", "ignore": false}], "tags": [], "notes": "bold Gothic, black on white balloon"}
{"id": "A_v19850_0", "set": "A", "vn": "v19850", "shot": "v19850_122860.jpg", "url": "https://t.vndb.org/sf/60/122860.jpg", "sha256": "263c694ba4ecb7de5250c03ba9a45a8ee151d4e69e8d798119acb5e16bc5d0df", "platform": "psv", "region": [240, 405, 735, 445], "mask": [], "lines": [{"box": [250, 407, 733, 443], "text": "「まさかとは思ったが……、即答かよ……」", "ignore": false}], "tags": [], "notes": "Gothic, black on white/grey comic box"}
{"id": "A_v19850_1", "set": "A", "vn": "v19850", "shot": "v19850_122861.jpg", "url": "https://t.vndb.org/sf/61/122861.jpg", "sha256": "fb3ddf1cfd150d54c46bc6bb000e6218957163f01fd26018f81ea7b7873e55ba", "platform": "psv", "region": [220, 410, 715, 482], "mask": [], "lines": [{"box": [225, 415, 712, 450], "text": "「あ、悪ィ。ガキの頃のつまんねー授業を", "ignore": false}, {"box": [238, 452, 598, 482], "text": "思い出しちまって、つい、な」", "ignore": false}], "tags": [], "notes": "Gothic, black on white/grey comic box"}
{"id": "A_v18162_0", "set": "A", "vn": "v18162", "shot": "v18162_103858.jpg", "url": "https://t.vndb.org/sf/58/103858.jpg", "sha256": "b4e085b30a27d215511ef9b8e2429777bfc804f17f5b828b73d8cf3c63edf0ee", "platform": "psv", "region": [215, 422, 780, 500], "mask": [], "lines": [{"box": [230, 422, 512, 459], "text": "「月読さん、困るなー。", "ignore": false}, {"box": [217, 461, 764, 497], "text": "アイドルの撮影は禁止されてますわよー？」", "ignore": false}], "tags": [], "notes": "Mincho, dark on light purple translucent box"}
{"id": "A_v18643_1", "set": "A", "vn": "v18643", "shot": "v18643_103698.jpg", "url": "https://t.vndb.org/sf/98/103698.jpg", "sha256": "874e0e421ecaf1596ae8f83a3e0c1ebf422214afa8e0fcd0815ac6bf9c122ca7", "platform": "psv", "region": [150, 410, 780, 492], "mask": [], "lines": [{"box": [154, 410, 749, 446], "text": "善と悪の二元論に当てはまらない灰色の感情だ。", "ignore": false}, {"box": [158, 452, 768, 488], "text": "それを持つ人間を……君を、僕は愛おしく思うよ。", "ignore": false}], "tags": [], "notes": "Mincho, dark on light translucent band"}
{"id": "A_v18643_0", "set": "A", "vn": "v18643", "shot": "v18643_103697.jpg", "url": "https://t.vndb.org/sf/97/103697.jpg", "sha256": "aab0a3e568332346028305bd84a059ec4b756e272da962cb84b3bbc9b44f5207", "platform": "psv", "region": [95, 85, 560, 378], "mask": [], "lines": [{"box": [101, 91, 465, 120], "text": "一人は、恋に溺れてしまった。", "ignore": false}, {"box": [102, 133, 465, 162], "text": "一人は、手を汚してしまった。", "ignore": false}, {"box": [102, 173, 464, 204], "text": "あの子が私の生きた証ならば、", "ignore": false}, {"box": [101, 216, 488, 245], "text": "二人の息子も私の生きた証……。", "ignore": false}, {"box": [100, 257, 493, 289], "text": "本当に、なんて愚かなんだろう。", "ignore": false}, {"box": [100, 300, 386, 332], "text": "愚かな一族。愚かな街。", "ignore": false}, {"box": [101, 341, 548, 373], "text": "でも、何よりも愚かだったのは……。", "ignore": false}], "tags": [], "notes": "Mincho, white NVL text over a fire background, 7 lines"}
{"id": "A_v15771_1", "set": "A", "vn": "v15771", "shot": "v15771_88699.jpg", "url": "https://t.vndb.org/sf/99/88699.jpg", "sha256": "6b970beb7ddc981468ba8c6ef28d598380cf5694129ff8d8f2c12db9c9311219", "platform": "psv", "region": [110, 418, 570, 484], "mask": [], "lines": [{"box": [116, 418, 417, 445], "text": "穏やかな笑みを浮かべると、", "ignore": false}, {"box": [116, 455, 559, 481], "text": "鉤翅さんは身を翻して来た道を引き返す。", "ignore": false}], "tags": [], "notes": "Mincho, dark on light translucent band"}

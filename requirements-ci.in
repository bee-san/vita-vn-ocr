# CI environment (.github/workflows/ci.yml): lint, unit tests, the training smoke
# and the PyTorch reference for the runtime parity test. Packages shared with
# requirements.in are resolved under requirements.lock as a constraint, so CI runs
# the same versions as the dev env. Regenerate requirements-ci.lock with:
#   uv pip compile requirements-ci.in -c requirements.lock -o requirements-ci.lock \
#     --python-version 3.11 --emit-index-url --generate-hashes \
#     --index-url https://download.pytorch.org/whl/cpu \
#     --extra-index-url https://pypi.org/simple --index-strategy unsafe-best-match

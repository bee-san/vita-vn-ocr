# The teacher labeller's own env (teacher/setup_venv.sh resolves this to teacher/requirements.lock,
# constrained by the repo's requirements.lock so shared packages keep the same versions).
# CPU only, local OCR engines only: nothing here talks to a cloud OCR.
#
# owocr itself (owocr==1.26.8) is installed by setup_venv.sh with --no-deps from
# teacher/owocr.txt (hash-pinned): its Linux GUI dependencies (PyGObject, pywayland, pynput,
# pystray, desktop-notifier, mss, obsws) need system headers this headless box lacks, and the
# labeller only uses owocr.ocr, whose module-level imports are numpy, Pillow, loguru and curl_cffi.

# MeikiOCR, the first engine (rtr46; the engine owocr's "meikiocr" key wraps)
meikiocr==0.3.5
# voters: PP-OCRv5 server and PP-OCRv6 small rec (rapidocr's ONNX files), manga-ocr
rapidocr==3.10.0
onnxruntime==1.30.0
manga-ocr==0.1.16
torch==2.5.1+cpu
transformers==4.46.3
huggingface-hub==0.36.2
numpy==2.4.6
pillow==12.3.0
opencv-python-headless==5.0.0.93
# owocr.ocr module-level imports
loguru==0.7.3
curl-cffi==0.16.3
jaconv==0.5.0
# dependencies of owocr's local NDLOCR-Lite engine (the labeller never loads it, and ndlocr_lite
# itself is not installed; pyyaml, networkx and tqdm are needed by other packages anyway)
lxml==6.1.3
pyyaml==6.0.3
